# Copie para .env (ou configure no Render). NUNCA suba o .env para o GitHub.
PORT=5000
# URL da API Java do ZelaBairro (sem barra no final). Vazio = chatbot sem consulta de ocorrências.
ZELA_API_URL=
# URL pública desta API Flask. Vazio = o chatbot usa os modelos dentro do próprio processo.
IA_API_URL=
# URL do front-end na Vercel, usada nos links que o chatbot mostra ao cidadão.
FRONT_URL=
# Origens permitidas no CORS, separadas por vírgula. * libera tudo (ok só em desenvolvimento).
CORS_ORIGINS=*
